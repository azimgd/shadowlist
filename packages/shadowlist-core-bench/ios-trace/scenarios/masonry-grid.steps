# Three column grid: prepends land in track order, so a correction has to cover
# a whole row of tracks, not one element.
route Masonry
latency 250,700
wait 2.5
mark scroll-mid
repeat 3 pan 200 700 0 -500 250
wait 1.5
mark prepend
press 296 80
wait 2.5
mark prepend-burst
repeat 3 press 296 80
wait 3.5
mark fling-then-prepend
press 296 80
pan 200 750 0 -550 120
wait 3
mark append-pages
repeat 6 pan 200 750 0 -600 100
wait 2
mark statusbar-top
statusbar
wait 3
