# Inverted native chat under abuse.
route ChatNative
latency 0,0
wait 3
mark append-burst-at-bottom
repeat 3 press 262 78
wait 2.5
mark fling-up-into-history
repeat 6 pan 200 200 0 600 100
wait 2
mark prepend-mid-fling-x2
pan 200 200 0 600 90
press 210 78
wait 0.3
press 210 78
wait 3
mark append-mid-fling-up
pan 200 200 0 600 90
press 262 78
wait 3
mark fling-down-with-append
pan 200 750 0 -650 90
press 262 78
wait 3
mark fling-to-bottom
repeat 10 pan 200 750 0 -700 100
wait 2.5
mark append-at-bottom-after-flings
press 262 78
wait 2
mark random-then-append
press 317 78
wait 1.5
press 262 78
wait 2.5
mark stt
statusbar
wait 3
