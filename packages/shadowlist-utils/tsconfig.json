{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "shadowlist": ["../shadowlist-fabric/src/index"],
      "react": [
        "../../templates/shadowlist-fabric-example/node_modules/@types/react"
      ],
      "react/*": [
        "../../templates/shadowlist-fabric-example/node_modules/@types/react/*"
      ],
      "react-test-renderer": [
        "../shadowlist-fabric/node_modules/@types/react-test-renderer"
      ],
      "react-native": [
        "../../templates/shadowlist-fabric-example/node_modules/react-native/types_generated/index.d.ts"
      ],
      "react-native-gesture-handler": [
        "../../templates/shadowlist-fabric-example/node_modules/react-native-gesture-handler"
      ],
      "react-native-reanimated": [
        "../../templates/shadowlist-fabric-example/node_modules/react-native-reanimated"
      ],
      "react-native-safe-area-context": [
        "../../templates/shadowlist-fabric-example/node_modules/react-native-safe-area-context"
      ]
    },
    "customConditions": ["react-native-strict-api"],
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "target": "ESNext",
    "types": ["jest"],
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["lib"]
}
