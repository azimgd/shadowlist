{
  "name": "shadowlist-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ShadowList monorepo — the shared C++ list engine and its React Native, UIKit, AppKit, Android and web kits.",
  "license": "MIT",
  "packageManager": "yarn@4.19.0",
  "workspaces": [
    "shadowlist-fabric",
    "shadowlist-wasm"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p shadowlist-fabric/tsconfig.json && tsc -p shadowlist-wasm/tsconfig.json --noEmit",
    "test": "yarn workspace shadowlist run test",
    "test:wasm": "yarn workspace shadowlist-wasm run test",
    "build:wasm": "yarn workspace shadowlist-wasm run build",
    "build": "yarn workspace shadowlist run prepare",
    "clean": "yarn workspace shadowlist run clean",
    "format": "prettier --write --config .prettierrc --ignore-path ../.gitignore --ignore-path .prettierignore ..",
    "format:check": "prettier --check --config .prettierrc --ignore-path ../.gitignore --ignore-path .prettierignore ..",
    "docs:check": "node scripts/check-readmes.mjs",
    "release:fabric": "yarn workspace shadowlist npm publish --tolerate-republish"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@evilmartians/lefthook": "^2.2.2",
    "@react-native/eslint-config": "0.88.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
