{
  "name": "shadowlist-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ShadowList monorepo — the shared C++ list engine and its React Native, UIKit, AppKit, Android and web kits.",
  "license": "MIT",
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "packages/shadowlist-fabric",
    "packages/shadowlist-wasm"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p packages/shadowlist-fabric/tsconfig.json && tsc -p packages/shadowlist-wasm/tsconfig.json --noEmit",
    "test": "yarn workspace shadowlist run test",
    "test:wasm": "yarn workspace shadowlist-wasm run test",
    "build:wasm": "yarn workspace shadowlist-wasm run build",
    "test:core": "cmake -S packages/shadowlist-core-tests -B packages/shadowlist-core-tests/build && cmake --build packages/shadowlist-core-tests/build && ctest --test-dir packages/shadowlist-core-tests/build --output-on-failure",
    "build": "yarn workspace shadowlist run prepare",
    "clean": "yarn workspace shadowlist run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-readmes.mjs",
    "release:fabric": "yarn workspace shadowlist npm publish --tolerate-republish"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@evilmartians/lefthook": "^1.12.3",
    "@react-native/eslint-config": "0.85.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.9.9",
    "typescript": "^6.0.2"
  }
}
